# Fal - Go Exercises

# Default recipe - show available commands
default:
    @just --list

# Run all Go tests
test:
    gotestsum --format testname ./...

# Run all tests (compact dots format)
test-dots:
    gotestsum --format dots ./...

# Run tests with coverage
test-coverage:
    go test ./... -coverprofile=coverage.out
    go tool cover -html=coverage.out -o coverage.html
    @echo "Coverage report: coverage.html"

# Run a specific exercise module
test-ds:
    gotestsum --format testname ./data_structures/...

test-concurrency:
    gotestsum --format testname ./concurrency/...

test-data:
    gotestsum --format testname ./data_processing/...

test-financial:
    gotestsum --format testname ./financial/...

# Run a single test by name (e.g., just test-one TestLRUCache)
test-one NAME:
    gotestsum --format testname -- -run {{NAME}} ./...

# Run tests in short mode (skip long-running tests)
test-short:
    gotestsum --format testname -- -short ./...

# Run benchmarks
bench:
    go test ./... -bench=. -benchmem

# Check for race conditions
test-race:
    gotestsum --format testname -- -race ./...

# Format all code
fmt:
    go fmt ./...

# Lint the code (requires golangci-lint)
lint:
    golangci-lint run

# Tidy dependencies
tidy:
    go mod tidy

# Build to check for compilation errors
build:
    go build ./...

# Clean generated files
clean:
    rm -f coverage.out coverage.html

# Watch tests (uses gotestsum's built-in watch mode)
watch:
    gotestsum --watch --format testname ./...

# Practice workflow: run single module tests in watch mode
watch-ds:
    gotestsum --watch --format testname ./data_structures/...

watch-concurrency:
    gotestsum --watch --format testname ./concurrency/...

watch-data:
    gotestsum --watch --format testname ./data_processing/...

watch-financial:
    gotestsum --watch --format testname ./financial/...
